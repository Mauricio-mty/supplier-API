# Conexión a PostgreSQL
# Opción A: URL completa (tiene prioridad si está definida)
DATABASE_URL=postgresql://usuario:password@localhost:5432/requisiciones

# Opción B: variables separadas (se usan si DATABASE_URL no está definida)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=tu_usuario
DB_PASSWORD=tu_contraseña
DB_NAME=requisiciones

# Autenticación
JWT_SECRET=tu_secreto_jwt
JWT_EXPIRES_IN=8h